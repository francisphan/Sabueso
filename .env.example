# Gemini API Key (for profile research & photo search)
GEMINI_API_KEY=your_gemini_api_key

# Anthropic API Key (for Claude — NLP intent parsing, vision checks, response formatting)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Salesforce Connected App OAuth
SF_CLIENT_ID=your_salesforce_client_id
SF_CLIENT_SECRET=your_salesforce_client_secret
SF_REFRESH_TOKEN=your_salesforce_refresh_token
SF_INSTANCE_URL=https://yourinstance.salesforce.com

# Gmail OAuth (for sending reports)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_SENDER=your.email@example.com

# Report subscribers (comma-separated)
REPORT_SUBSCRIBERS=subscriber1@example.com,subscriber2@example.com

# MCP Server (Agent B)
MCP_BASE_URL=https://agent-b-mcp-production.up.railway.app
MCP_WRITE_TOKEN=your-mcp-write-token
MCP_TIMEOUT=30

# Wine-owner enrichment (optional — defaults to enabled).
# When on, the guest report asks Agent B (NetSuite) whether an arriving guest is
# one of The Vines' wine owners and, if so, researches their label on the open web
# (Gemini + Google Search). Set to "false" to skip it (e.g. local dev without MCP).
# WINE_ENRICHMENT_ENABLED=true

# Slack App credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Access control
BOT_ADMIN_USER_ID=U0ACKBHM2S1
ACL_FILE=acl.json

# Sales-rep write mode (optional — defaults shown)
# Cache of Slack-user-id -> Salesforce User.Id resolved via profile email lookup
SF_USER_MAP_FILE=.cache/sf_user_map.json
# Append-only audit trail of bot-initiated SF writes (one JSONL record per write)
WRITE_AUDIT_FILE=.cache/write_audit.jsonl
# Per-turn telemetry (token usage, tool calls, write events)
METRICS_FILE=.cache/metrics.jsonl
# Durable conversation history. With REDIS_URL set, per-conversation history is
# stored in Redis so it survives restarts/redeploys (Railway's Redis plugin
# injects this automatically). Leave blank for local dev (in-memory fallback).
REDIS_URL=
# Capture raw payloads (the human request text + tool args/results) at INFO and
# embed the request text in each metrics record. Off by default so guest PII
# stays out of the logs; turn on to mine real requests for composite-tool design.
SABUESO_DEBUG_PAYLOADS=

# NLP model (optional — defaults to claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Bot behavior
LOG_LEVEL=INFO
